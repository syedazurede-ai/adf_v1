{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "databeli-v1-syed"
		},
		"LS_SQL_DB_ADF_V1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_DB_ADF_V1'"
		},
		"LS_ADLS_ADF_v1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adfstoragedatabeliv1.dfs.core.windows.net/"
		},
		"LS_SQL_DB_ADF_V1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "adf-v1-syed.database.windows.net"
		},
		"LS_SQL_DB_ADF_V1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "demo_adf_v1_syed"
		},
		"LS_SQL_DB_ADF_V1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "adf_v1_syed"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/Email_notifications')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Email_notify",
						"type": "WebActivity",
						"dependsOn": [
							{
								"activity": "set_email_body",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "POST",
							"headers": {
								"Content-Type": "application/json"
							},
							"url": "https://prod-02.centralindia.logic.azure.com:443/workflows/a8cea147b61b493d95835b417ab77b40/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=9ooaiqfedQfmlrEQ_M5DY1szyNtZXrgr8HKNtgqnOPo",
							"body": {
								"value": "@variables('email_body')",
								"type": "Expression"
							}
						}
					},
					{
						"name": "set_email_body",
						"type": "SetVariable",
						"dependsOn": [
							{
								"activity": "Subject",
								"dependencyConditions": [
									"Succeeded"
								]
							},
							{
								"activity": "prepare_body",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "email_body",
							"value": {
								"value": "{\n    \"email_reciepent\":\"@{pipeline().parameters.email_receipent}\",\n    \"subject\" : \"@{variables('Subject')}\",\n    \"Body\" : \"@{variables('prepare_body')}\"\n}",
								"type": "Expression"
							}
						}
					},
					{
						"name": "Subject",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "Subject",
							"value": {
								"value": "table name @{pipeline().parameters.table_name} - @{pipeline().parameters.status}",
								"type": "Expression"
							}
						}
					},
					{
						"name": "prepare_body",
						"type": "SetVariable",
						"dependsOn": [],
						"policy": {
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"variableName": "prepare_body",
							"value": {
								"value": "The table @{pipeline().parameters.table_name} ingestion has successfully comepleted and the staus is - @{pipeline().parameters.status}",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"table_name": {
						"type": "string"
					},
					"status": {
						"type": "string"
					},
					"email_receipent": {
						"type": "string"
					}
				},
				"variables": {
					"email_body": {
						"type": "String"
					},
					"Status": {
						"type": "String"
					},
					"body": {
						"type": "String"
					},
					"Subject": {
						"type": "String"
					},
					"prepare_body": {
						"type": "String"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-23T13:27:02Z"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/For_each_pipeline')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "ForEach1",
						"type": "ForEach",
						"dependsOn": [
							{
								"activity": "List of tables",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"items": {
								"value": "@activity('List of tables').output.value",
								"type": "Expression"
							},
							"isSequential": false,
							"activities": [
								{
									"name": "Execute copy data",
									"type": "ExecutePipeline",
									"dependsOn": [],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "SQL_to_ADLS",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"file_name": {
												"value": "@item().table_name",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					},
					{
						"name": "List of tables",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT table_name from metadata.table_list",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "AzureSqlTable1",
								"type": "DatasetReference",
								"parameters": {
									"schema": "metada",
									"table_name": "table_list"
								}
							},
							"firstRowOnly": false
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-23T14:37:30Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/AzureSqlTable1')]",
				"[concat(variables('factoryId'), '/pipelines/SQL_to_ADLS')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/SQL_to_ADLS')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Execute_email_notification",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "Check_new_data",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "Email_notifications",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"table_name": {
									"value": "@pipeline().parameters.file_name",
									"type": "Expression"
								},
								"status": "Success",
								"email_receipent": {
									"value": "@pipeline().globalParameters.email_reciepent",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "Execute_email_notification_copy1",
						"type": "ExecutePipeline",
						"dependsOn": [
							{
								"activity": "Check_new_data",
								"dependencyConditions": [
									"Failed"
								]
							}
						],
						"policy": {
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"pipeline": {
								"referenceName": "Email_notifications",
								"type": "PipelineReference"
							},
							"waitOnCompletion": true,
							"parameters": {
								"table_name": {
									"value": "@pipeline().parameters.file_name",
									"type": "Expression"
								},
								"status": "Failed",
								"email_receipent": {
									"value": "@pipeline().globalParameters.email_reciepent",
									"type": "Expression"
								}
							}
						}
					},
					{
						"name": "read watermark",
						"type": "Lookup",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "SELECT watermark_value from metadata.table_watermarks WHERE table_name = '@{toLower(pipeline().parameters.file_name)}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "AzureSqlTable1",
								"type": "DatasetReference",
								"parameters": {
									"schema": "dbo",
									"table_name": "customers"
								}
							}
						}
					},
					{
						"name": "Check count",
						"type": "Lookup",
						"dependsOn": [
							{
								"activity": "read watermark",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"source": {
								"type": "AzureSqlSource",
								"sqlReaderQuery": {
									"value": "select count(*) as count  from @{pipeline().parameters.file_name} where ModifiedDate > '@{activity('read watermark').output.firstRow.watermark_value}'",
									"type": "Expression"
								},
								"queryTimeout": "02:00:00",
								"partitionOption": "None"
							},
							"dataset": {
								"referenceName": "AzureSqlTable1",
								"type": "DatasetReference",
								"parameters": {
									"schema": "dbo",
									"table_name": "customers"
								}
							}
						}
					},
					{
						"name": "Check_new_data",
						"type": "IfCondition",
						"dependsOn": [
							{
								"activity": "Check count",
								"dependencyConditions": [
									"Succeeded"
								]
							}
						],
						"userProperties": [],
						"typeProperties": {
							"expression": {
								"value": "@greater(activity('Check count').output.firstRow.count , 0)",
								"type": "Expression"
							},
							"ifTrueActivities": [
								{
									"name": "Demo_v1_adf",
									"type": "Copy",
									"dependsOn": [],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"source": {
											"type": "AzureSqlSource",
											"sqlReaderQuery": {
												"value": "SELECT * from dbo.@{toLower(pipeline().parameters.file_name)} WHERE ModifiedDate >  '@{activity('read watermark').output.firstRow.watermark_value}'\n",
												"type": "Expression"
											},
											"queryTimeout": "02:00:00",
											"partitionOption": "None"
										},
										"sink": {
											"type": "DelimitedTextSink",
											"storeSettings": {
												"type": "AzureBlobFSWriteSettings"
											},
											"formatSettings": {
												"type": "DelimitedTextWriteSettings",
												"quoteAllText": true,
												"fileExtension": ".txt"
											}
										},
										"enableStaging": false,
										"translator": {
											"type": "TabularTranslator",
											"typeConversion": true,
											"typeConversionSettings": {
												"allowDataTruncation": true,
												"treatBooleanAsNumber": false
											}
										}
									},
									"inputs": [
										{
											"referenceName": "AzureSqlTable1",
											"type": "DatasetReference",
											"parameters": {
												"schema": "dbo",
												"table_name": {
													"value": "@pipeline().parameters.file_name",
													"type": "Expression"
												}
											}
										}
									],
									"outputs": [
										{
											"referenceName": "ADLS_dataset",
											"type": "DatasetReference",
											"parameters": {
												"file_name": {
													"value": "@pipeline().parameters.file_name",
													"type": "Expression"
												}
											}
										}
									]
								},
								{
									"name": "update water mark",
									"type": "Script",
									"dependsOn": [
										{
											"activity": "Demo_v1_adf",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"timeout": "0.12:00:00",
										"retry": 0,
										"retryIntervalInSeconds": 30,
										"secureOutput": false,
										"secureInput": false
									},
									"userProperties": [],
									"linkedServiceName": {
										"referenceName": "LS_SQL_DB_ADF_V1",
										"type": "LinkedServiceReference"
									},
									"typeProperties": {
										"scripts": [
											{
												"type": "Query",
												"text": {
													"value": "update metadata.table_watermarks SET watermark_value =  SYSUTCDATETIME() \nwhere table_name = '@{toLower(pipeline().parameters.file_name)}'",
													"type": "Expression"
												}
											}
										],
										"scriptBlockExecutionTimeout": "02:00:00"
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"parameters": {
					"file_name": {
						"type": "string",
						"defaultValue": "customers"
					}
				},
				"variables": {
					"Status_check": {
						"type": "String"
					},
					"new_status": {
						"type": "Array"
					},
					"v1_status": {
						"type": "Integer"
					},
					"count": {
						"type": "String"
					}
				},
				"annotations": [],
				"lastPublishTime": "2026-10-23T14:37:30Z"
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/pipelines/Email_notifications')]",
				"[concat(variables('factoryId'), '/datasets/AzureSqlTable1')]",
				"[concat(variables('factoryId'), '/datasets/ADLS_dataset')]",
				"[concat(variables('factoryId'), '/linkedServices/LS_SQL_DB_ADF_V1')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ADLS_dataset')]",
			"type": "Microsoft.DataFactory/factories/datasets",
			"apiVersion": "2018-06-01",
			"properties": {
				"linkedServiceName": {
					"referenceName": "LS_ADLS_ADF_v1",
					"type": "LinkedServiceReference"
				},
				"parameters": {
					"file_name": {
						"type": "string"
					}
				},
				"annotations": [],
				"type": "DelimitedText",
				"typeProperties": {
					"location": {
						"type": "AzureBlobFSLocation",
						"fileName": {
							"value": "@concat(toLower(dataset().file_name),'_',utcNow())",
							"type": "Expression"
						},
						"folderPath": {
							"value": "@toLower(dataset().file_name)",
							"type": "Expression"
						},
						"fileSystem": "demo-container"
					},
					"columnDelimiter": ",",
					"escapeChar": "\\",
					"firstRowAsHeader": true,
					"quoteChar": "\""
				},
				"schema": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/LS_ADLS_ADF_v1')]"
			]
		},
